PORT=8787
WEBHOOK_BEARER_TOKEN=replace_with_a_strong_token

# Slack Web API (bot token xoxb-...)
SLACK_BOT_TOKEN=
SLACK_PR_ALERTS_CHANNEL_ID=
SLACK_BACKLOG_CHANNEL_ID=

# Vercel Deploy Snapshot (opcional; necessário para /cron/deploy-status-sync)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_DEPLOY_LIST_LIMIT=8
# Valores aceitos: pr_alerts, backlog
DEPLOY_SNAPSHOT_CHANNEL_TARGET=pr_alerts
